# Copier ce fichier en .env.local (non commité) et choisir l'API visée.
#
# NEXT_PUBLIC_API_URL : URL de base de l'API AlloProf, /api compris.
# Intégrée au build (préfixe NEXT_PUBLIC_) : redémarrer `npm run dev` ou redéployer après un changement.
#
#   Environnement de test d'équipe (Hostinger, données partagées par toute l'équipe) :
#     NEXT_PUBLIC_API_URL=https://alloprof-backend.casseautojj.fr/api
#   Backend local (`npm run dev` dans ../AlloProf-Backend) :
#     NEXT_PUBLIC_API_URL=http://localhost:4000/api
#
# L'origine du front (ex. http://localhost:3000) doit figurer dans CORS_ORIGINS côté backend.

NEXT_PUBLIC_API_URL=https://alloprof-backend.casseautojj.fr/api
